{
  "name": "perso-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "generate:api": "openapi-typescript ../persob/docs/openapi.yaml -o src/api/schema.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- src/api/schema.ts"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
